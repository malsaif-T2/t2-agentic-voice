# LF line endings in the repository and in every working copy, on every OS, so Windows
# development and Linux CI see byte-identical files.
* text=auto eol=lf

# Binary files: never convert line endings or diff as text.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.db binary
*.sqlite binary
# Audio: the golden set's audio stays out of git, and a stray file is still never converted.
*.wav binary
*.webm binary
*.ogg binary
*.mp3 binary
*.m4a binary
*.flac binary
