# Copy to `.env` and fill in. Never commit `.env`.
# Written by `uv run poe settings-ref` from the library's VoiceSettings
# (packages/t2-agentic-voice/src/t2_agentic_voice/core/config.py): never edit it by hand, since
# tests/t2_agentic_voice/core/test_settings_ref.py fails when it is stale. The library reads a
# `.env` only when it is given one (VoiceSettings.from_env(env_file=...)), and environment
# variables override it. A group's keys nest with `__` (T2V_GROQ__API_KEY is
# settings.groq.api_key), a list or a map is JSON, and a blank value keeps the default. Every
# key below is blank, its default given in the comment just above it: write a value only to
# change one, so a copy follows a default that changes later. docs/generated/settings.md
# describes each setting in a table. The apps' own settings follow the library's, each under its
# app's prefix (and T2's shared services under their general names).

# Where the library runs: dev, test, staging or prod; required, with no default. Outside dev the dev
# page and logged call content are refused, and staging and prod refuse DEBUG.
T2V_ENV=

# Groq, the provider of every model for now (D-004). The library reads only these names, never
# GROQ_API_KEY or GROQ_BASE_URL. The SDKs under it read a few variables of their own whatever is
# passed: leave unset those the guide lists (docs/guide/README.md, "Variables to leave unset").
# The API key, required by the Groq adapters; or give api_key_file instead.
T2V_GROQ__API_KEY=
# Or the full path of a file outside the repository that holds only the key, so the key can live
# outside .env.
T2V_GROQ__API_KEY_FILE=
# Groq's API address, always passed to the SDK so it never falls back to GROQ_BASE_URL. HTTPS only,
# since the key travels with every request.
# Default: https://api.groq.com
T2V_GROQ__BASE_URL=

# ElevenLabs: speech-to-text (Scribe) now, voices later; measured beside Groq (D-100).
# The provider's API key; unset, its adapters are unavailable and say so when chosen. Or give
# api_key_file instead.
T2V_ELEVENLABS__API_KEY=
# Or the full path of a file outside the repository that holds only the key, so the key can live
# outside .env.
T2V_ELEVENLABS__API_KEY_FILE=

# Speechmatics: speech-to-text, its Arabic-English pack; measured beside Groq (D-100).
# The provider's API key; unset, its adapters are unavailable and say so when chosen. Or give
# api_key_file instead.
T2V_SPEECHMATICS__API_KEY=
# Or the full path of a file outside the repository that holds only the key, so the key can live
# outside .env.
T2V_SPEECHMATICS__API_KEY_FILE=
# Where Speechmatics processes the audio: eu (its eu1 endpoints) or us (us1). eu by default, the
# region its data terms were read for (D-100).
# Default: eu
T2V_SPEECHMATICS__REGION=
# The longest one batch transcription may take, from the job's upload to its transcript: a batch job
# queues and polls, so it takes longer than stt.timeout_s allows one request, and its time is
# measured, never assumed.
# Default: 60
T2V_SPEECHMATICS__JOB_TIMEOUT_S=

# Cohere: speech-to-text (Transcribe Arabic); measured beside Groq (D-100).
# The provider's API key; unset, its adapters are unavailable and say so when chosen. Or give
# api_key_file instead.
T2V_COHERE__API_KEY=
# Or the full path of a file outside the repository that holds only the key, so the key can live
# outside .env.
T2V_COHERE__API_KEY_FILE=

# Soniox: speech-to-text, batch and streaming; measured beside Groq (D-100).
# The provider's API key; unset, its adapters are unavailable and say so when chosen. Or give
# api_key_file instead.
T2V_SONIOX__API_KEY=
# Or the full path of a file outside the repository that holds only the key, so the key can live
# outside .env.
T2V_SONIOX__API_KEY_FILE=
# The longest one async transcription may take, from the file's upload to its transcript: the job
# queues and polls, so its time is measured, never assumed.
# Default: 60
T2V_SONIOX__JOB_TIMEOUT_S=

# OpenAI: a talker and speech-to-text to measure beside Groq (D-100).
# The provider's API key; unset, its adapters are unavailable and say so when chosen. Or give
# api_key_file instead.
T2V_OPENAI__API_KEY=
# Or the full path of a file outside the repository that holds only the key, so the key can live
# outside .env.
T2V_OPENAI__API_KEY_FILE=
# OpenAI's API address; another only for a regional route OpenAI gives the account. HTTPS only,
# since the key travels with every request.
# Default: https://api.openai.com/v1
T2V_OPENAI__BASE_URL=

# Inworld: voices to measure beside Groq's (D-100); the key in the Base64 form the portal copies.
# The provider's API key; unset, its adapters are unavailable and say so when chosen. Or give
# api_key_file instead.
T2V_INWORLD__API_KEY=
# Or the full path of a file outside the repository that holds only the key, so the key can live
# outside .env.
T2V_INWORLD__API_KEY_FILE=

# Telnyx: speech-to-text through its engines, HUMAIN's Arabic engine among them; measured beside
# Groq (D-100).
# The provider's API key; unset, its adapters are unavailable and say so when chosen. Or give
# api_key_file instead.
T2V_TELNYX__API_KEY=
# Or the full path of a file outside the repository that holds only the key, so the key can live
# outside .env.
T2V_TELNYX__API_KEY_FILE=
# The longest one turn may take over the provider's WebSocket, from the connection to its last
# transcript; its time is measured, never assumed.
# Default: 30
T2V_TELNYX__TURN_TIMEOUT_S=
# Once the turn's audio is sent, the longest the adapter waits for the provider's first final
# transcript; none by then, the turn heard no words. Part of the turn's measured time.
# Default: 3
T2V_TELNYX__FINAL_WAIT_S=
# Once a final transcript has come and the audio is sent, how long a quiet socket (no message) means
# the provider has said all it heard, when it does not close the socket itself; part of the turn's
# measured time.
# Default: 0.5
T2V_TELNYX__QUIET_S=
# The Telnyx speech-to-text model: humain/realtime (HUMAIN's Arabic engine with Arabic-English
# code-switching, on Telnyx's streaming WebSocket, the default), or deepgram/nova-3 or
# openai/whisper-large-v3-turbo (its batch endpoint).
# Default: humain/realtime
T2V_TELNYX__STT_MODEL=
# The wait between two 100 ms chunks of a turn's audio sent to a streamed model, in milliseconds:
# 100 is real time, 50 (the default) twice as fast. HUMAIN's engine dropped most of a turn sent all
# at once and the end of one sent four times as fast (25), and heard two 5 s turns whole at 50 and
# 33 (probed 2026-11-16). A turn's time grows by its length times this gap over 100.
# Default: 50
T2V_TELNYX__CHUNK_GAP_MS=

# HUMAIN: its own key, kept for its speech, voice and chat APIs once their reference is given; no
# adapter reads it yet (D-100).
# The provider's API key; unset, its adapters are unavailable and say so when chosen. Or give
# api_key_file instead.
T2V_HUMAIN__API_KEY=
# Or the full path of a file outside the repository that holds only the key, so the key can live
# outside .env.
T2V_HUMAIN__API_KEY_FILE=

# Nabrah: Saudi Arabic speech-to-text on its streaming WebSocket; measured beside Groq (D-100).
# The provider's API key; unset, its adapters are unavailable and say so when chosen. Or give
# api_key_file instead.
T2V_NABRAH__API_KEY=
# Or the full path of a file outside the repository that holds only the key, so the key can live
# outside .env.
T2V_NABRAH__API_KEY_FILE=
# The longest one turn may take over the provider's WebSocket, from the connection to its last
# transcript; its time is measured, never assumed.
# Default: 30
T2V_NABRAH__TURN_TIMEOUT_S=
# Once the turn's audio is sent, the longest the adapter waits for the provider's first final
# transcript; none by then, the turn heard no words. Part of the turn's measured time.
# Default: 3
T2V_NABRAH__FINAL_WAIT_S=
# Once a final transcript has come and the audio is sent, how long a quiet socket (no message) means
# the provider has said all it heard, when it does not close the socket itself; part of the turn's
# measured time.
# Default: 0.5
T2V_NABRAH__QUIET_S=

# Speech-to-text: the adapter, the Whisper model, how long a request may take, the language and the
# prompt a call sends, the classifier of each turn's language, and the filter for text from silence.
# Which adapter turns speech into text: elevenlabs (Scribe v3, the default, D-105; it needs
# T2V_ELEVENLABS__API_KEY), groq (Whisper, the fallback, on the Groq key alone), or one measured
# beside them (D-100): speechmatics (its ar_en pack, a batch job), cohere (Transcribe Arabic, the
# language always named), soniox (stt-async-v6, a batch job), telnyx (the model telnyx.stt_model
# names, HUMAIN's Arabic engine by default, a turn on its WebSocket) or nabrah (its Saudi Arabic
# model, a turn on its WebSocket); a provider with no key set is refused when chosen, naming its
# key's setting.
# Default: elevenlabs
T2V_STT__PROVIDER=
# The Whisper model: whisper-large-v3 or whisper-large-v3-turbo. The default stayed large-v3 on a
# registered measurement (D-025), and changes only on another (GP-18).
# Default: whisper-large-v3
T2V_STT__MODEL=
# The longest one transcription request may take before it is a timeout.
# Default: 6
T2V_STT__TIMEOUT_S=
# The language a live call sends Whisper: session (the call's language, fixed when it joins from the
# caller's pick or the join token's locale), auto (none, so Whisper detects it) or classified (each
# turn's, chosen among the agent's languages by the classifier `stt.classifier` names from the
# turn's first `stt.classifier_from_s` seconds; a short, unsure, late, busy or failed turn keeps the
# language last classified, the call's until one is) or detected (each request names the call's
# current language, and a turn with `stt.detect_from_s` seconds of voiced speech or more is also
# sent naming none, at the same time: when Whisper hears the agent's other language in a question or
# request, never a short reply, that transcript is the turn's and the call moves to that language;
# on speechmatics, cohere, telnyx or nabrah, which report no language heard, no second request goes,
# and only a switch request or the talker moves the call) or hinted (each turn's one request names
# the call's current language as a hint and the agent's other languages beside it, which Scribe v3
# takes as secondary languages; when the answer gives one of the agent's other languages with a
# probability of at least `stt.switch_min_probability`, in a question or request, never a short
# reply, the call moves to it, and a switch request or the talker moves it too; on a provider that
# gives no language probability, every one but elevenlabs, it runs as session, which the runtime's
# start logs) or single (each turn sends one request: a turn with `stt.detect_from_s` seconds of
# voiced speech or more names no language, and its answer is the turn's words, moving the call by
# hinted's rule; a shorter turn names the call's current language and never moves it; on a provider
# that gives no language probability it runs as session, which the runtime's start logs). A
# registered measurement sets the default (GP-18).
# Default: session
T2V_STT__LIVE_LANGUAGE=
# Under live_language detected or single, the seconds of voiced speech a turn needs, from where the
# speech detector heard it begin to where it last heard it stop (never the silence after), for its
# request naming no language (detected's second, single's one); a shorter turn keeps the call's
# current language. 1.2, registered for run H (D-038's amendment).
# Default: 1.2
T2V_STT__DETECT_FROM_S=
# Under live_language hinted or single, the least probability the provider must give the language it
# heard, one of the agent's other languages, for the turn to move the call (with a question or
# request, never a short reply); under it the call keeps its language. 0.8, a placeholder until run
# H's Scribe arms are measured (GP-18).
# Default: 0.8
T2V_STT__SWITCH_MIN_PROBABILITY=
# The spoken-language classifier under live_language classified: silero (Silero's 95 languages, on
# onnxruntime) or ecapa (ECAPA on VoxLingua107, on torch through SpeechBrain, which needs the
# library's ecapa extra: uv sync --group language-id in this workspace).
# Default: silero
T2V_STT__CLASSIFIER=
# The folder of the classifier's model files, fetched once by hand as the guide's languages page
# says and each checked against its pinned SHA-256 at every start and by t2v doctor; never under a
# repository or var/. No default: live_language classified is refused at start without it.
T2V_STT__CLASSIFIER_DIR=
# The seconds of a turn's audio, from where the speech detector heard its speech begin, that the
# classifier hears; pauses inside the turn count. A turn whose request goes with less keeps the
# current language (short). 2.0, registered for run H (plan 007, Q20).
# Default: 2
T2V_STT__CLASSIFIER_FROM_S=
# The best share of the agent's languages the classifier must give a turn to move the call's current
# language; under it the turn keeps it (unsure). 0.7, registered for run H (plan 007, Q20).
# Default: 0.7
T2V_STT__CLASSIFIER_MIN_SHARE=
# The CPU threads the classifier's model runs on; one classification runs at a time a process, and a
# turn that finds it busy keeps the current language (busy).
# Default: 2
T2V_STT__CLASSIFIER_THREADS=
# The no-speech probability Whisper reports above which a transcript counts as no words (text from
# silence), for a turn and for speech over a reply, from 0 to 1; unset, the threshold is off. 0.55
# by the registered rule F and its one revision (plan 005), which changes only on another registered
# measurement (GP-18).
# Default: 0.55
T2V_STT__NO_SPEECH_MAX=
# Whether a transcript that is one of the captions Whisper invents for silence or noise counts as no
# words; on by the registered rule F (plan 005), which changes only on another registered
# measurement (GP-18).
# Default: true
T2V_STT__CAPTION_FILTER=
# Whether a call hears the caller over one stream of the provider's for the whole call (elevenlabs:
# Scribe v3 Live, plan 010's 5.1) rather than one request a turn: each turn's audio goes as it
# comes, from its pre-roll, silence in place of the rest of the call, and each turn's end commits
# it, its words back 249.9 ms later at the median (the probe of 2026-11-18 on dev, against 567.5 ms
# for a request). Only under live_language session, or a mode that runs as session, on a provider
# that streams; an overlap's parts still go as requests, and a stream that fails leaves the rest of
# the call to requests. The provider bills every second of the stream, silence included. Off until a
# live check keeps it (GP-18).
# Default: false
T2V_STT__STREAMING=
# Whether each speech-to-text request of a call sends Whisper the prompt of the language it names:
# the agent's vocabulary, then the command words as they should be written. On since run W's arm W1
# (plan 006), which on the golden set raised Whisper's right count beyond the noise on dev (stop
# words 0.69 to 0.92, repeat requests 0.32 to 0.53) and on held-out (accuracy 0.382 to 0.420, word
# errors 0.254 to 0.218, stop words 0.778 to 0.889); it changes only on another registered
# measurement (GP-18).
# Default: true
T2V_STT__SEND_PROMPT=

# The chat model the talker writes its replies with: the adapter, the model, how much it reasons,
# the most it may write, how long a request may take, whether each request opens with a line of its
# own, the most requests a turn, and whether a rejected request is sent once more.
# Which adapter reaches the talker's chat model: groq (D-004), or openai, OpenAI's own API with the
# openai group's key (D-112), off by default. Under openai the yes rule's check and the uncertain
# overlap's request stay on Groq's gpt-oss-120b, so the Groq key is needed too.
# Default: groq
T2V_LLM__PROVIDER=
# The chat model: on groq openai/gpt-oss-120b, openai/gpt-oss-20b, llama-3.3-70b-versatile or
# llama-3.1-8b-instant; on openai gpt-6-luna, gpt-5.6-luna, gpt-5.4-mini or gpt-6.1-terra. The
# default changes only on a registered measurement (GP-18).
# Default: openai/gpt-oss-120b
T2V_LLM__MODEL=
# How much a reasoning model thinks before it answers: none, low, medium or high, as its model takes
# them (the gpt-oss models low to high; OpenAI's only none, the one its Chat Completions take with
# tools). Sent only to a model that takes it. Medium, as the owner ruled on run K's dev pass (plan
# 006, Q26): gpt-oss-120b invented 6 answers of 136 against 18 at low, for about 0.33 s more to the
# first clause.
# Default: medium
T2V_LLM__REASONING_EFFORT=
# The most tokens one model request may write, its reasoning included: a spoken reply is one to
# three short sentences, or every step of a procedure.
# Default: 1024
T2V_LLM__MAX_OUTPUT_TOKENS=
# The longest one model request may take before it is a timeout.
# Default: 8
T2V_LLM__TIMEOUT_S=
# Whether each request's system message opens with a line new on every request, so no two requests
# share a prefix the provider has cached. Groq's cache can be slow: on openai/gpt-oss-120b with one
# app's system prompt, 3 of the 8 requests it served from its cache took 1.03, 1.25 and 5.71 s to
# the first token, while 12 requests with a first line of their own all took 0.15 to 0.30 s
# (2026-11-07, D-072).
# Default: true
T2V_LLM__VARY_FIRST_LINE=
# The most model requests one turn makes: each but the last offers the agent's tools, the last none,
# so the turn ends in words.
# Default: 3
T2V_LLM__MAX_REQUESTS_PER_TURN=
# Whether a request of a turn the provider rejects (a rejected error, such as Groq's tool_use_failed
# when the model wrote a malformed tool call) is sent once more, with a new first line and nothing
# of the first kept, when nothing of it was said yet and neither a leak nor the question limit
# stopped the reply (D-132): never twice for one request, and not counted in max_requests_per_turn.
# Off: the reply ends with the error notice, as before.
# Default: false
T2V_LLM__RETRY_REJECTED=

# Text-to-speech: the adapter, a model and a voice for each language, and what is done with the
# audio.
# Which adapter turns text into speech: elevenlabs (v4 Turbo in the owner's voice for Saad, the
# default, D-114; it needs T2V_ELEVENLABS__API_KEY, as Scribe does), groq (Orpheus, the fallback, on
# the Groq key alone) or telnyx (Bayan, measured beside them; it needs T2V_TELNYX__API_KEY). With
# tts.languages unset, each language is spoken in the chosen provider's default model and voice.
# Default: elevenlabs
T2V_TTS__PROVIDER=
# The model and voice of each language preset (ar-SA, ar, en), in tts.provider's own names, as a
# JSON object: {"en": {"model": "canopylabs/orpheus-v1-english", "voice": "troy"}}. A value replaces
# the whole map; unset, it is the provider's default map.
# Default: {"ar-SA": {"model": "eleven_v4_turbo", "voice": "nhJWWCFdNdusuVUT3x19"}, "ar": {"model": "eleven_v4_turbo", "voice": "nhJWWCFdNdusuVUT3x19"}, "en": {"model": "eleven_v4_turbo", "voice": "nhJWWCFdNdusuVUT3x19"}}
T2V_TTS__LANGUAGES=
# The longest one synthesis request may take before it is a timeout.
# Default: 6
T2V_TTS__TIMEOUT_S=
# Whether the fixed phrases declared at start (greetings, notices) are synthesized once and cached
# under the storage folder.
# Default: true
T2V_TTS__CACHE_PHRASES=
# Whether every clause the agent speaks in a call with a talker is kept on disk under the storage
# folder by its exact text, its language, its voice and the adapter that made it, so the same clause
# plays again with no request; the echo's words said back are never kept. On by default, as the
# owner ruled: it costs only disk, bounded by clause_cache_mb.
# Default: true
T2V_TTS__CACHE_CLAUSES=
# The most disk the clause cache keeps, in megabytes; past it, the clauses played longest ago are
# removed.
# Default: 512
T2V_TTS__CLAUSE_CACHE_MB=
# How a reply's numbers, times and dates are said: as_written reads each run of digits as a number
# (num2words' MSA in Arabic) or an ID; by_register says them in the caller's register, Saudi or MSA
# words in Arabic, a time as a clock says it with its part of the day, an ISO date with its weekday
# and month.
# Default: as_written
T2V_TTS__SPOKEN_NUMBERS=
# Whether a key combination in a reply is said as its keys, its plus signs left out ("Ctrl + Shift +
# R" is said "Control Shift R"; in Arabic, by the Arabic names of its keys); off, it is said as
# written.
# Default: false
T2V_TTS__SPOKEN_KEY_COMBINATIONS=
# Whether the silence the model puts before its speech is trimmed; off, the audio plays as it comes.
# Default: false
T2V_TTS__TRIM_SILENCE=
# Whether the talker's replies are spoken on the provider's streaming socket, one a call, each
# clause sent as the talker writes it and each reply one turn of the voice (ElevenLabs'
# Text-to-Dialogue socket, for its v3 and v4 models; D-121). Fixed lines, an action's lines and the
# clause cache's takes keep to one request a clause, as does a provider or model with no socket; a
# socket's failure turns it off for the rest of the call. Off by default until it is measured.
# Default: false
T2V_TTS__STREAM_REPLIES=

# Turn-taking: the speech detector (Silero VAD) and the end-of-turn model (Smart Turn).
# How sure the speech detector must be that a frame is speech, from 0 to 1.
# Default: 0.7
T2V_TURNS__VAD_CONFIDENCE=
# How long speech must last before the detector says the caller started.
# Default: 200
T2V_TURNS__VAD_START_MS=
# How long a silence must last before the detector says the caller paused.
# Default: 200
T2V_TURNS__VAD_STOP_MS=
# The quietest a frame may be and still count as speech, from 0 to 1.
# Default: 0.6
T2V_TURNS__VAD_MIN_VOLUME=
# Whether Smart Turn decides, at each pause, if the caller has finished; off, every pause the
# detector hears ends the turn.
# Default: true
T2V_TURNS__SMART_TURN=
# How sure Smart Turn must be that the caller has finished, from 0 to 1: a pause ends the turn when
# its probability is above this. 0.5, Smart Turn's own, leaves a turn's end as it was.
# Default: 0.5
T2V_TURNS__SMART_TURN_THRESHOLD=
# How long a turn Smart Turn judged finished waits before it ends: speech that resumes within it
# cancels the end, and the turn goes on. 600 by plan 005's registered E (its arm Ec, the owner's
# ruling), which changes only on another registered measurement (GP-18); 0 ends the turn at Smart
# Turn's verdict. The speech detector's pause, which an interruption waits on, is never delayed.
# Default: 600
T2V_TURNS__COMPLETE_HOLD_MS=
# Whether, in a call with a talker, a turn's speech so far goes to speech-to-text as the speech
# detector hears it stop, Smart Turn's time before its verdict: kept only when Smart Turn calls the
# turn finished, dropped when it calls the pause unfinished or the caller speaks again, the next
# pause sending again. Needs complete_hold_ms above 0. Off: the request goes at Smart Turn's
# verdict.
# Default: false
T2V_TURNS__EARLY_AT_STOP=
# The silence after which Smart Turn ends the turn whatever it heard.
# Default: 3000
T2V_TURNS__SMART_TURN_STOP_MS=
# How much audio before the speech started Smart Turn hears with it.
# Default: 500
T2V_TURNS__SMART_TURN_PRE_SPEECH_MS=
# How many CPU threads Smart Turn's model runs on at each pause: more judge sooner on a laptop with
# cores to spare, the same verdicts.
# Default: 1
T2V_TURNS__SMART_TURN_THREADS=
# The most audio of a turn Smart Turn hears, its latest part.
# Default: 8
T2V_TURNS__SMART_TURN_MAX_DURATION_S=
# The fallback end of a turn: a silence this long ends it, whatever decides.
# Default: 3000
T2V_TURNS__MAX_SILENCE_MS=
# The fallback end of a turn said while an action's read-back awaits its answer, in place of
# max_silence_ms, so a pause after a yes ("yes, but change ...") is not taken for its end; Smart
# Turn's own smart_turn_stop_ms still ends it, and it needs complete_hold_ms above 0. Unset:
# max_silence_ms for every turn.
T2V_TURNS__READ_BACK_SILENCE_MS=

# Interruptions: how the caller's speech over the agent's reply is taken, and the bounds of the rule
# that decides whether it stops the agent.
# How the caller's speech over the agent's reply is taken: two_step, the default by the owner's
# ruling (plan 005), lowers the agent's voice, transcribes the speech, and stops the agent only when
# the rule says so; drop keeps the half-duplex behaviour from before plan 005 (the turn is not
# answered, so the agent never answers its own voice).
# Default: two_step
T2V_INTERRUPTIONS__MODE=
# How loud the agent's reply plays while the caller speaks over it, until the speech is judged, from
# 0 (silent) to 1 (unchanged).
# Default: 0.25
T2V_INTERRUPTIONS__DUCK_LEVEL=
# The first part of the speech over a reply sent to speech-to-text before the caller has finished,
# counted from 300 ms before the speech detector heard it begin.
# Default: 750
T2V_INTERRUPTIONS__FIRST_WINDOW_MS=
# The fewest words over a reply that stop the agent when none is a listed word.
# Default: 2
T2V_INTERRUPTIONS__MIN_WORDS=
# The most words a short output holds: at most this many, under short_s of speech, and none a stop,
# repeat or no word, the agent goes on (a listening sound misheard).
# Default: 2
T2V_INTERRUPTIONS__SHORT_WORDS=
# The speech a short output stays under, for the agent to go on; 1.2 by the rule's one revision
# (plan 005).
# Default: 1.2
T2V_INTERRUPTIONS__SHORT_S=
# How far back the agent's own words count: speech over a reply whose words are those of the clauses
# played this long before is its own voice, heard back.
# Default: 5
T2V_INTERRUPTIONS__OWN_WORDS_S=
# Whether a yes said over an action's read-back books once its summary has played whole, with no
# other words said after it (the closing question then cut), and a bare yes over the closing
# question books too, as khalas beside a yes or a send word does: the owner's 'Any yes books'
# (D-108). Off: a yes over the summary counts for nothing, and over the closing question a yes needs
# a send word.
# Default: false
T2V_INTERRUPTIONS__YES_OVER_READ_BACK=
# Whether a yes said over the question that ends any reply of the agent's (a yes or a send word
# among only yes words, send words and fillers, never the agent's own words heard back, begun once
# every clause before the question played, or in the 0.3 s after the reply ended), which the agent's
# voice goes on over, is answered as the caller's next turn once the reply's tail and the speech
# detector's lag have passed, never when the reply was stopped or other words were said after it:
# the owner's 'Any yes books' for agents with no read-back (D-116). An action's read-back keeps its
# own rule (yes_over_read_back). Off: such a yes is not answered.
# Default: false
T2V_INTERRUPTIONS__ANSWER_YES_OVER_QUESTION=

# Words: what a team adds to each language's lists, which the interruption rule reads.
# Words added to each language's stop words, which stop the agent at once, as a JSON object from a
# language's code (ar, en) to a list: {"ar": ["..."]}. A value replaces the map.
T2V_WORDS__STOP=
# Words added to each language's words asking the agent to pause, which stop it as a stop word, as a
# JSON object from a language's code (ar, en) to a list: {"ar": ["..."]}. A value replaces the map.
T2V_WORDS__WAIT=
# Words added to each language's repeat words, which stop the agent and say its last reply again, as
# a JSON object from a language's code (ar, en) to a list: {"ar": ["..."]}. A value replaces the
# map.
T2V_WORDS__REPEAT=
# Words added to each language's listening sounds, after which the agent goes on, as a JSON object
# from a language's code (ar, en) to a list: {"ar": ["..."]}. A value replaces the map.
T2V_WORDS__BACKCHANNEL=
# Words added to each language's no words, which a short output never holds, as a JSON object from a
# language's code (ar, en) to a list: {"ar": ["..."]}. A value replaces the map.
T2V_WORDS__NO=
# Words added to each language's yes words, which the yes rule reads, as a JSON object from a
# language's code (ar, en) to a list: {"ar": ["..."]}. A value replaces the map.
T2V_WORDS__YES=
# Words added to each language's send words, which a yes over the closing question needs, and which
# a yes over any reply's question may be (interruptions.answer_yes_over_question), as a JSON object
# from a language's code (ar, en) to a list: {"ar": ["..."]}. A value replaces the map.
T2V_WORDS__SEND=
# Product terms added to the declaration's vocabulary, which becomes the Whisper prompt, as a JSON
# list: ["VPN", "Outlook"]. A value replaces the list.
T2V_WORDS__VOCABULARY=
# Saudi forms added to the library's list the register of the caller's Arabic is read by, as a JSON
# list of Arabic words or phrases; a phrase of several words is one of them heard as those words in
# a row. A value replaces the list.
T2V_WORDS__DIALECT=
# The register every ar-SA call is held in from its start to its end, whatever the caller says:
# saudi (the Saudi spoken register) or msa; unset (the default), it is read from the caller's words
# as dialect and saudi_first say.
T2V_WORDS__FIXED_REGISTER=
# Whether an ar-SA call reads the caller as Saudi unless they plainly speak MSA: a turn with no
# Saudi form is MSA only when it holds one of the library's few forms only MSA says (ureed, awadd,
# hal, matha, al-aan, sawfa and the like), and a turn with neither keeps the call's register, Saudi
# until an MSA one is heard; a Saudi form makes the call Saudi from then on. Off: a turn with no
# Saudi form is MSA.
# Default: false
T2V_WORDS__SAUDI_FIRST=

# The output guard: what counts as an ID, and what a clause that speaks one with no evidence drops.
# More ID shapes, beside runs of min_id_digits digits, as a JSON list of regular expressions, such
# as ["LT-\\d{5}"]. A pattern that matches no text at all (the empty text) is refused. Unset: none.
T2V_GUARD__ID_PATTERNS=
# The fewest digits in a row, after digit words and Arabic-Indic digits are made digits, that count
# as an ID, which passes only with evidence from this call.
# Default: 3
T2V_GUARD__MIN_ID_DIGITS=
# What a blocked clause drops: drop_rest, it and the rest of the reply, or drop_clause, only it. A
# fixed phrase is spoken in its place either way.
# Default: drop_rest
T2V_GUARD__ON_BLOCK=
# Phrases added to each language's default list of what claims any action, as a JSON object from a
# language's code to a list: {"ar": ["..."]}. A value replaces the map. An agent that declares no
# action, only tools that declare claims, reads these alone, without the defaults.
T2V_GUARD__CLAIMS=
# Whether each character of a script none of the agent's languages writes (a Chinese character in an
# Arabic reply), and each pictograph, is taken out of what the talker writes, its tool calls'
# arguments included, before the guard reads it, and a digit of another script written as its ASCII
# digit; the voice, the captions, the history, the trace and the events then hold the text without
# it. Off: kept as written.
# Default: true
T2V_GUARD__REMOVE_STRAY_SCRIPT=
# The most questions one spoken reply of the talker's may ask the caller: the reply stops before the
# next one, which is not said, nor anything after it. A question is a clause that ends with a
# question mark. None, given in code: no limit.
# Default: 1
T2V_GUARD__QUESTIONS_PER_REPLY=
# Whether a reply the question limit stopped also drops the tool calls of the request it stopped in:
# on, none of them runs, so the question the caller heard ends the turn; off, they run and are kept,
# as before.
# Default: false
T2V_GUARD__QUESTION_STOP_DROPS_CALLS=
# Whether a stage note or a tag the model writes into its answer counts as its reasoning, so nothing
# of that request is said from it on and none of its tools runs: in a reply in Arabic script, a
# parenthesis or bracket glued to a sentence's end with a capital Latin letter after it; in any
# language, one that opens a stage word ("(Waiting", "[No output"); and a "<" that opens a tag
# ("<action", "<data", or a tool's or an action's name). Arabic in parentheses never counts. In a
# reply in Arabic script, a word that opens as the reasoning does ("We need", "The user") after text
# written in Arabic script counts wherever a word starts (after a space, a parenthesis, an ellipsis
# or any mark), not only glued to a sentence's end; an English reply keeps the glued rule alone.
# Off: none counts.
# Default: false
T2V_GUARD__DROP_STAGE_NOTES=
# Whether only plain speech is said (D-111): a run of dots after a sentence's mark is taken out, and
# one after a word made one ellipsis; a clause whose characters, spaces aside, are less than half
# letters or digits, or that holds a bracket, a brace or a tag's opening, is not said, nor anything
# after it of its request, and none of that request's tools runs; a request that said nothing so is
# sent once more while the turn has a request left; and zero-width spaces, word joiners, byte order
# marks, asterisks and backticks are taken out of every clause. Off: said as written.
# Default: false
T2V_GUARD__PLAIN_SPEECH=
# Whether a reply whose clause the claim rule blocked (it said an action or a tool's write was done,
# and no result of the call says so) asks the model once more, once a turn: neither the clause nor
# the error notice in its place is said, nor anything of its request after it, none of that
# request's tools runs, and the request is sent again with what it said before the clause and a note
# that the claim was held back, one request past llm.max_requests_per_turn. A claim blocked again is
# dropped as on_block says. Off: as on_block says, the error notice said in its place.
# Default: false
T2V_GUARD__RETRY_CLAIMS=

# The voice session: what answers the caller.
# What answers each turn: echo, which says back what it heard, or talker, which answers with the
# chat model and the agent's tools. Unset: the declaration's, talker for an agent that declares
# instructions and echo for one that does not.
T2V_SESSION__MODE=
# The silence after a tool's progress line before the answer, in ms, counted from the end of the
# line's speech: the take's own silence after it is cut first. Unset: the take as it is, then 400
# ms, the beat around every fixed line said next to other speech.
T2V_SESSION__PROGRESS_BEAT_MS=
# Whether a turn held while a reply to an earlier turn is still in progress (nothing of it playing
# as the turn began) starts the talker early too: that reply is stopped as the turn's held words
# come, as the turn's answer would stop it, so the talker reads it as cut. Off: such a turn starts
# the talker once it has ended.
# Default: false
T2V_SESSION__EARLY_OVER_REPLY=

# Serving: the backend's address, the pages that may call it, how media finds a path, and the dev
# page with the test console's dev caller.
# The address callers reach the backend at, such as https://voice.example.
T2V_SERVER__PUBLIC_URL=
# The pages allowed to call the backend from a browser, as a JSON list of origins (scheme, host and
# port only, written as a browser sends them: lowercase; a host name of letters, digits and hyphens,
# in its xn-- form, or an IP address in its shortest form; no default port), such as
# ["https://www.example.com"]. Unset: none.
T2V_SERVER__ALLOWED_ORIGINS=
# The STUN and TURN servers a call is given, as a JSON list of stun:, turn: or turns: URLs with no
# credentials (TURN's are minted per call from turn_secret).
T2V_SERVER__ICE_SERVERS=
# The secret shared with the TURN server, which signs each call's credentials: at least 32 bytes. Or
# give turn_secret_file instead.
T2V_SERVER__TURN_SECRET=
# Or the full path of a file that holds only the TURN secret.
T2V_SERVER__TURN_SECRET_FILE=
# How long each call's TURN credentials last, at most 86400 (a day).
# Default: 3600
T2V_SERVER__TURN_TTL_S=
# Whether the router serves its /dev page, to loopback clients; dev only.
# Default: false
T2V_SERVER__DEV_PAGE=
# The caller the test console's Start makes a signed join token for, under env dev with the dev page
# on: a JSON object, such as {"subject": "owner", "attributes": {"customer_email":
# "demo@example.com"}}, read as the library's Caller. An app usually sets it in code. Unset: the
# console makes none and joins as dev.
T2V_SERVER__DEV_CALLER=
# The proxies whose X-Forwarded-For headers are trusted, as a JSON list of IP addresses or networks,
# such as ["127.0.0.1"], a network by its own address (10.0.0.0/24): an entry is no wider than /8
# for IPv4 or /32 for IPv6, and no wider than /104 where it overlaps ::ffff:0:0/96, ::ffff:0:0:0/96,
# 64:ff9b::/96, 64:ff9b:1::/48 or ::/96, or /24 where it overlaps 2002::/16, the IPv6 ranges that
# carry IPv4 addresses; "*" is refused. Unset: none.
T2V_SERVER__FORWARDED_ALLOW_IPS=

# Join tokens: the keys that sign and verify them, and how long one lives.
# The keys that verify join tokens, as a JSON object from key ID to secret, each secret at least 32
# bytes. Or give keys_file instead.
T2V_JOIN__KEYS=
# Or the full path of a file that holds the key map, the same JSON object as keys.
T2V_JOIN__KEYS_FILE=
# The ID of the key that signs new tokens; one of the map's.
T2V_JOIN__CURRENT_KID=
# How long a join token lives, at most 120.
# Default: 60
T2V_JOIN__TTL_S=
# How far a token's times may be off this machine's clock and still verify, at most 60: a token
# verifies until its expiry plus this.
# Default: 30
T2V_JOIN__MAX_CLOCK_SKEW_S=

# Privacy: whether a call's audio may be recorded, and the consent version callers agree to
# (docs/SECURITY.md, invariant 8).
# Whether a call's audio may be recorded under the storage folder: only when this is on and the
# caller's signed join token says they consented.
# Default: false
T2V_PRIVACY__RECORD_AUDIO=
# The version of the consent text callers agree to (1 to 64 printable characters, no space); when
# set, a signed join token holding another version is refused (a consent no signed token gave, as
# the dev identity's, keeps no audio and is not compared). Unset: any.
T2V_PRIVACY__CONSENT_VERSION=

# Logging: the level and format of the library's lines, and what they may hold.
# DEBUG, INFO, WARNING or ERROR; staging and prod refuse DEBUG.
# Default: INFO
T2V_LOGGING__LEVEL=
# console (human-readable) or json (machine-queryable).
# Default: console
T2V_LOGGING__FORMAT=
# Whether log lines may hold what was said in a call; refused outside dev (docs/SECURITY.md,
# invariant 8).
# Default: false
T2V_LOGGING__CONTENT=
# What becomes of the voice framework's own log lines: off, the only value.
# Default: off
T2V_LOGGING__PIPECAT=

# Tracing, as plain OTLP over HTTP to Phoenix or any OpenTelemetry backend (D-023).
# Where spans are sent: an OTLP/HTTP traces endpoint, such as a local Phoenix's
# http://127.0.0.1:6006/v1/traces. Unset: no span leaves the process, unless the app passes its own
# tracer provider.
T2V_TRACING__ENDPOINT=
# The project the spans are filed under in Phoenix. Unset: the default one.
T2V_TRACING__PROJECT=
# Whether spans carry what was said: what the caller was heard to say, the agent's replies and its
# tool calls with their results are the only call content a trace holds (docs/SECURITY.md, invariant
# 8).
# Default: true
T2V_TRACING__INCLUDE_TRANSCRIPTS=
# Regular expressions; every match is replaced in each text attribute before it is exported. A JSON
# list, such as ["\\d{10}"]. Unset: none.
T2V_TRACING__REDACT=

# Limits on one call.
# The longest a call may last; the library ends it then.
# Default: 600
T2V_LIMITS__MAX_CALL_S=
# The longest a call may go with nothing heard from the caller; then it ends.
# Default: 120
T2V_LIMITS__IDLE_S=
# How many of one kind of action one caller may have done in a day, counted from the outbox: every
# write that may have reached the system, none refused or never sent. Beyond it the action is
# refused before its read-back. The agent's starting value.
# Default: 20
T2V_LIMITS__ACTIONS_PER_CALLER_PER_DAY=

# Storage: one folder for everything the library keeps.
# Local runtime data (git-ignored): databases, run outputs, caches. Every path under it comes from
# here, so one setting moves a whole run, a test session included.
# Default: var
T2V_STORAGE__VAR_DIR=

# The warm-up: what the server's start and each call's join ready for the turns to come.
# Whether the server's start imports the modules a call's offer needs (Pipecat's pipeline, aiortc's
# peer) in a thread, and keeps one call's speech detector and turn analyzer made ahead, the next
# made in the background as each call takes one. Off: the first offer imports them on the event
# loop, and each call makes its own.
# Default: false
T2V_WARMUP__AT_START=
# Whether each call, as it joins, sends one request that costs nothing to the call's speech-to-text
# and its text-to-speech (and to the chat model when its connection is not warm), in the background,
# so their connections are open before the first turn. A failed one is logged and never fails the
# call.
# Default: false
T2V_WARMUP__AT_JOIN=
# Whether the Groq chat adapter opens a fresh connection in the background after a cancelled or
# closed stream, which closes its connection, so the next request does not pay a new handshake.
# Default: false
T2V_WARMUP__AFTER_CANCEL=

# The Ole5 app's own settings (apps/ole5-voice-agent, ole5_voice/settings.py), read by its server:
# its own under OLE5_VOICE_, and T2's knowledge base and embedding service under the general names
# the owner set. Not the library's: the prefix T2V_ is the library's alone.
# T2's Qdrant behind its sign-in gateway, over HTTPS. Unset: no knowledge base.
QDRANT_URL=
# The account the app signs in to T2's gateway with.
QDRANT_LOGIN_EMAIL=
# That account's password.
QDRANT_LOGIN_PASSWORD=
# Where the app signs in to T2's gateway, over HTTPS.
# Default: https://ds.t2.sa/ole5_agent/api/login
QDRANT_LOGIN_URL=
# T2's embedding service, which embeds each question, over HTTPS.
# Default: https://ds.t2.sa/text_embed
EMBEDDING_URL=
# The tenant whose points the search reads: Ole5's own.
# Default: ole5
OLE5_VOICE_KB_TENANT=
# The code the owner types in the widget to get a join token, at least 16 characters.
# Required.
OLE5_VOICE_ACCESS_CODE=
# The website allowed to frame the widget's page, an origin as a browser sends it
# (https://www.example.com). Unset: no page may frame it.
OLE5_VOICE_WEBSITE_ORIGIN=
# The customer every join token names, whose tickets a call makes and reads. Nothing said in a call
# changes it.
# Default: ole5.test@example.com
OLE5_VOICE_DEMO_CUSTOMER_EMAIL=
# How the mock ticket system answers each write: answer, refuse, timeout (no reply, nothing done) or
# late (done, the reply late).
# Default: answer
OLE5_VOICE_TICKETS_MODE=
# Whether the mock ticket system finds a write by its request ID.
# Default: true
OLE5_VOICE_TICKETS_LOOKUP=
# The folder the mock ticket system keeps its tickets in. Unset: ole5/tickets under the library's
# storage.var_dir.
OLE5_VOICE_TICKETS_DIR=

# The flight-booking agent's own settings (apps/flight-voice-agent, flight_voice/settings.py), read
# by its server, under FLIGHT_VOICE_: the flight data's source (flight_data/settings.py), its access
# code, its page, the mock airline's today and modes, and the persona's names. Not the library's:
# the prefix T2V_ is the library's alone.
# Whether every call is kept in the call log's database (call_log/): its setup, every event, its
# turns and times, its tool calls and its recording's folder.
# Default: true
FLIGHT_VOICE_CALL_LOG=
# The call log's SQLite file; unset, calls.sqlite3 in the app's storage folder (var/flight/ by
# default).
FLIGHT_VOICE_CALL_LOG_PATH=
# The flights the lean agent reads: mock (the mock airline), recorded (SerpApi's answers replayed
# from flight_data_fixtures) or serpapi (live, needs the key).
# Default: mock
FLIGHT_VOICE_FLIGHT_DATA=
# SerpApi's key, for flight_data serpapi.
FLIGHT_VOICE_SERPAPI_KEY=
# Whether SerpApi searches as Google Flights' page does (deep_search), slower.
# Default: false
FLIGHT_VOICE_SERPAPI_DEEP_SEARCH=
# How long one search (a day, or a span's calendar) may take, its retry included; the read timeout
# is one second less. Phase 0's searches took 1.1 to 4.1 s, but a first search on a cold connection
# passed 8 s.
# Default: 12
FLIGHT_VOICE_FLIGHT_DATA_DEADLINE_S=
# The most days of a span searched day by day.
# Default: 14
FLIGHT_VOICE_FLIGHT_DATA_SPAN_DAYS=
# The days of a span searched at once.
# Default: 14
FLIGHT_VOICE_FLIGHT_DATA_SPAN_CONCURRENCY=
# How long a span read day by day may take; a day not answered by then is unknown.
# Default: 8
FLIGHT_VOICE_FLIGHT_DATA_SPAN_DEADLINE_S=
# How long a live answer is kept for the same day asked again; 0 keeps none.
# Default: 600
FLIGHT_VOICE_FLIGHT_DATA_CACHE_S=
# The folder the recorded source replays from. Unset: the app's own
# (apps/flight-voice-agent/evals/flight_data).
FLIGHT_VOICE_FLIGHT_DATA_FIXTURES=
# With flight_data serpapi, a folder each answer is recorded into, without the key. Unset: nothing
# recorded.
FLIGHT_VOICE_FLIGHT_DATA_RECORD_TO=
# The code a caller types on the page to get a join token, at least 16 characters; unset, the page
# asks for none and any caller may call (the daily cap holds).
FLIGHT_VOICE_ACCESS_CODE=
# The website allowed to frame the page, an origin as a browser sends it (https://www.example.com).
# Unset: no page may frame it.
FLIGHT_VOICE_WEBSITE_ORIGIN=
# The join tokens minted a day.
# Default: 200
FLIGHT_VOICE_TOKENS_PER_DAY=
# The airline's today: live (today in Riyadh at each read) or a date (2026-11-16) pinned.
# Default: live
FLIGHT_VOICE_TODAY=
# How the mock bookings store answers a write: answer, refuse, timeout (no reply, nothing done) or
# late (done, the reply late).
# Default: answer
FLIGHT_VOICE_BOOKING_MODE=
# Whether the mock bookings store finds a write by its ID.
# Default: true
FLIGHT_VOICE_BOOKING_LOOKUP=
# How the mock airline answers a search, the fare calendar and the cabins: answer, fail or slow.
# Default: answer
FLIGHT_VOICE_SEARCH_MODE=
# How the mock airline answers the profile: answer or fail.
# Default: answer
FLIGHT_VOICE_PROFILE_MODE=
# How long a slow read of the airline waits.
# Default: 4
FLIGHT_VOICE_SLOW_S=
# The agent served: scripted (today's, with its read-back and yes rule) or lean (the model-led one
# beside it, D-113).
# Default: scripted
FLIGHT_VOICE_AGENT=
# The persona's name in English.
# Default: Saad
FLIGHT_VOICE_PERSONA_NAME_EN=
# The persona's name in Arabic.
# Default: سعد
FLIGHT_VOICE_PERSONA_NAME_AR=
# The airline's name in English.
# Default: T2 Air
FLIGHT_VOICE_AIRLINE_NAME_EN=
# The airline's name in Arabic.
# Default: طيران تي تو
FLIGHT_VOICE_AIRLINE_NAME_AR=
# The airline's two-character code, on cards and flight numbers; never said unless asked.
# Default: T2
FLIGHT_VOICE_AIRLINE_CODE=
# The code said in English.
# Default: tee two
FLIGHT_VOICE_AIRLINE_CODE_SAID_EN=
# The code said in Arabic.
# Default: تي تو
FLIGHT_VOICE_AIRLINE_CODE_SAID_AR=
