# Copy to `.env` and fill in. Never commit `.env`.
# Every key maps to a field on the library's Settings
# (packages/t2-agentic-voice/src/t2_agentic_voice/core/config.py), and
# tests/t2_agentic_voice/core/test_config.py fails when the two differ. Environment variables
# override `.env`. A group's keys nest with `__` (T2V_GROQ__API_KEY is settings.groq.api_key),
# and a blank value keeps the default.

# dev, test, or prod
T2V_ENV=dev
# DEBUG, INFO, WARNING, or ERROR
T2V_LOG_LEVEL=INFO
# console (human-readable) or json (machine-queryable)
T2V_LOG_FORMAT=console

# Local runtime data (git-ignored): databases, run outputs, caches.
T2V_VAR_DIR=var

# Groq, the provider of every model for now. Fill in the key, or the key file below. Only these
# names are read, never GROQ_API_KEY or GROQ_BASE_URL.
T2V_GROQ__API_KEY=
# Or the full path of a file outside the repository that holds only the key.
T2V_GROQ__API_KEY_FILE=
# Groq's API address (HTTPS only).
T2V_GROQ__BASE_URL=https://api.groq.com

# Speech-to-text: the adapter (only groq exists), the Whisper model (whisper-large-v3 or
# whisper-large-v3-turbo), and the most seconds one request may take.
T2V_STT__PROVIDER=groq
T2V_STT__MODEL=whisper-large-v3
T2V_STT__TIMEOUT_S=6

# Tracing, as OTLP over HTTP. The traces endpoint, such as a local Phoenix's
# http://127.0.0.1:6006/v1/traces; blank: no spans leave the process.
T2V_TRACING__ENDPOINT=
# The project the spans are filed under in Phoenix; blank: the default project.
T2V_TRACING__PROJECT=
# Whether spans carry transcripts: true or false.
T2V_TRACING__INCLUDE_TRANSCRIPTS=true
# Regular expressions replaced in every text attribute before export, as a JSON list, such as
# ["\\d{10}"]; blank: none.
T2V_TRACING__REDACT=
