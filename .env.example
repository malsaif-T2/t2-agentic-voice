# Copy to `.env` and fill in. Never commit `.env`.
# Every key maps to a field on Settings in src/ole5_voice/core/config.py, and
# tests/core/test_config.py fails when the two differ. Environment variables override `.env`.

# dev, test, or prod
OLE5_VOICE_ENV=dev
# DEBUG, INFO, WARNING, or ERROR
OLE5_VOICE_LOG_LEVEL=INFO
# console (human-readable) or json (machine-queryable)
OLE5_VOICE_LOG_FORMAT=console

# Local runtime data (git-ignored): databases, run outputs, caches.
OLE5_VOICE_VAR_DIR=var
